{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "rootDir": "..",
  "moduleFileExtensions": ["js", "json", "ts"],
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", {}]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1",
    "^@ordo/shared$": "<rootDir>/../../packages/shared/src/index.ts",
    "^@ordo/shared/(.*)$": "<rootDir>/../../packages/shared/src/$1.ts"
  },
  "testTimeout": 30000
}
